{
  "name": "auto-mecanica-nelson",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run watch:eui\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:eui": "(cd packages/ethyl-ui && npm run build && cd ../..)",
    "watch:eui": "(cd packages/ethyl-ui && npm start && cd ../../)",
    "update:eui": "npm run build:eui && npm i ./packages/ethyl-ui",
    "dev:eui": "(cd packages/ethyl-ui && npx storybook dev && cd ../..)",
    "publish:dev": "npm run build:eui && npm run build && cp out/index.html out/200.html && surge out auto-mecanica-nelson.surge.sh",
    "dev:system": "(cd packages/chatbot-system-backend && npm run dev && cd ../../)",
    "dev:channel": "npm run channel:dev",
    "channel:activate-venv": "(packages/chatbot-channel-backend/scripts/venv-activate.sh)",
    "channel:update-requirements": "(cd packages/chatbot-channel-backend && scripts/freeze.sh && cd ../../)",
    "channel:run-docker": "podman run -d -p 8000:80 --name ams-chatbot-channel-container ams-chatbot-channel",
    "channel:stop-docker": "podman stop ams-chatbot-channel-container && podman rm ams-chatbot-channel-container",
    "channel:build-docker": "podman build -t ams-chatbot-channel ./packages/chatbot-channel-backend",
    "channel:docker": "npm run channel:stop-docker && npm run channel:build-docker && npm run channel:run-docker",
    "channel:dev": "(cd packages/chatbot-channel-backend && source ./.venv/bin/activate & fastapi dev src/__init__.py && cd ../../)"
  },
  "dependencies": {
    "ethyl-ui": "./packages/ethyl-ui",
    "next": "16.0.10",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "globals": "^17.3.0",
    "surge": "^0.24.6",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
