{
  "name": "auto-mecanica-nelson",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/ethyl-ui"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run watch:eui\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:eui": "(cd packages/ethyl-ui && npm run build && cd ../..)",
    "watch:eui": "(cd packages/ethyl-ui && npm start && cd ../../)",
    "update:eui": "npm run build:eui && npm i ./packages/ethyl-ui",
    "dev:eui": "(cd packages/ethyl-ui && npx storybook dev && cd ../..)",
    "publish:dev": "npm run build:eui && npm run build && cp out/index.html out/200.html && surge out auto-mecanica-nelson.surge.sh",
    "dev:system": "(cd packages/chatbot-system-backend && npm run dev && cd ../../)",
    "dev:channel": "npm run channel:dev",
    "system:build-docker": "(cd packages/chatbot-system-backend && docker build . && cd ../../)",
    "channel:activate-venv": "(packages/chatbot-channel-backend/scripts/unix/venv/activate.sh)",
    "channel:activate-venv:windows": "(packages/chatbot-channel-backend/scripts/windows/venv/activate.bat)",
    "channel:update-requirements": "(cd packages/chatbot-channel-backend && scripts/unix/dependencies/freeze.sh && cd ../../)",
    "channel:update-requirements:windows": "(cd packages/chatbot-channel-backend && scripts/windows/dependencies/freeze.bat && cd ../../)",
    "channel:run-docker": "(cd packages/chatbot-channel-backend && docker run -p 8000:80 . && cd ../../)",
    "channel:stop-docker": "docker stop ams-chatbot-channel-container && docker rm ams-chatbot-channel-container",
    "channel:build-docker": "(cd packages/chatbot-channel-backend && docker build . && cd ../../)",
    "channel:docker": "npm run channel:stop-docker && npm run channel:build-docker && npm run channel:run-docker",
    "channel:dev": "(cd packages/chatbot-channel-backend && source ./.venv/bin/activate & fastapi dev src/__init__.py && cd ../../)",
    "channel:dev:windows": "(packages/chatbot-channel-backend/scripts/windows/start.bat)",
    "docker:backends-build": "npm run system:build-docker && npm run channel:build-docker",
    "docker:backends-start": "docker compose -f docker-compose.backends.yml -p amn-backends up",
    "docker:backends-stop": "docker compose -f docker-compose.backends.yml down -v",
    "docker:backends": "npm run docker:backends-stop & npm run docker:backends-build && npm run docker:backends-start",
    "set:agent": "mkdir .github & mkdir .github/agents & cp \"packages/ai-agents/frontend/React.agent.md\" .github/agents/AGENTS.md",
    "system:vehicle:docker": "packages/vehicle-system-api/scripts/linux/run.sh"
  },
  "dependencies": {
    "ethyl-ui": "./packages/ethyl-ui",
    "jest-cli": "0.10.0",
    "next": "^16.2.9",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.1",
    "eslint-config-next": "^16.1.6",
    "globals": "^17.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^2.12.10",
    "nock": "^13.3.0",
    "node-fetch": "^2.6.9",
    "surge": "^0.27.4",
    "ts-jest": "^29.4.11",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
